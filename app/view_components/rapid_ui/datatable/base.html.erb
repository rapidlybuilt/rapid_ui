<%= component_tag do %>
  <%= header %>

  <div class="table-responsive">
    <table class="datatable table table-bordered">
      <thead>
        <tr>
          <% columns.each do |column| %>
            <th scope="col">
              <%= column_label column %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <%= row_tag row do %>
            <% columns.each do |column| %>
              <td>
                <%= column_cell_html(row, column) %>
              </td>
            <% end %>
          <% end %>
        <% end %>
      </tbody>
    </table>

    <% if rows.none? %>
      <p class="datatable-empty-message"><%= empty_message %></p>
    <% end %>
  </div>

  <%= footer %>
<% end %>
