<%= component_tag do %>
  <h1><%= title %></h1>

  <%= form_with url: form_url, method: :get, local: true do |f| %>
    <div class="flex">
      <%= f.text_field :q,
        value: nil,
        placeholder: placeholder,
        autofocus: true,
        autocomplete: "off",
        data: {
          action: "input->search-page#onInput",
          search_page_target: "input"
        } %>
      <%= f.submit submit_text, name: nil %>
    </div>
  <% end %>

  <%= tag.div class: "search-page-query-container", data: { stimulus_controller.target => "queryContainer" } do %>
    Results for "<%= tag.span query, data: { stimulus_controller.target => "query" } %>"
  <% end %>

  <%= tag.div data: { stimulus_controller.target => "results" } do %>
    <% results.each do |result| %>
      <%= render result %>
    <% end %>
  <% end %>

  <%= tag.div data: { stimulus_controller.target => "emptyResults" }, class: "search-page-no-results hidden" do %>
    <span><%= empty_results_text %></span>
  <% end %>

  <%= tag.div data: { stimulus_controller.target => "loading" }, class: "search-page-loading hidden" do %>
    <%= render loading if loading? %>
  <% end %>

  <%# Template for rendering search results %>
  <%= tag.template data: { stimulus_controller.target => "resultTemplate" } do %>
    <%= render build(RapidUI::Search::Result) %>
  <% end %>
<% end %>
