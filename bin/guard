#!/usr/bin/env ruby
# frozen_string_literal: true

# Run Guard from the rapid_ui gem root so the Guardfile and test paths resolve correctly.
# Usage: ./bin/guard [guard options]

gem_root = File.expand_path("..", __dir__)
Dir.chdir(gem_root)

ENV["BUNDLE_GEMFILE"] ||= File.join(gem_root, "Gemfile")

require "rubygems"
require "bundler/setup"

load Gem.bin_path("guard", "guard")
