#!/usr/bin/env ruby

require "bundler/setup"
require_relative "../lib/rapid_ui/commands/icons"

base_dir = File.expand_path("..", __dir__)

# import into the docs app via: `bin/icons docs import <icon>`
if ARGV.first == "docs"
  ARGV.shift
  base_dir = File.join(base_dir, "docs")
end

RapidUI::Commands::Icons.new(base_dir:).run(ARGV)
